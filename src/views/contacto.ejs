<%- include('partials/head') %>
<%- include('partials/header') %>

<h1>Contacto</h1>

<% if (enviado) { %>
  <p class="aviso ok" role="status">Mensaje enviado. Te respondemos a la brevedad.</p>
<% } else { %>
  <% if (locals.errorEnvio) { %>
    <p class="aviso fallo" role="alert">No pudimos enviar tu consulta. Probá de nuevo en unos minutos.</p>
  <% } %>
  <p class="lead">Contanos qué equipo o proyecto tenés y te respondemos por email.</p>
  <form method="POST" action="/contacto" class="formulario" novalidate>
    <label for="nombre">Nombre</label>
    <input id="nombre" name="nombre" value="<%= datos.nombre || '' %>">
    <% if (errores.nombre) { %><p class="error"><%= errores.nombre %></p><% } %>

    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="<%= datos.email || '' %>">
    <% if (errores.email) { %><p class="error"><%= errores.email %></p><% } %>

    <label for="mensaje">Consulta</label>
    <textarea id="mensaje" name="mensaje" rows="5"><%= datos.mensaje || '' %></textarea>
    <% if (errores.mensaje) { %><p class="error"><%= errores.mensaje %></p><% } %>

    <button class="boton" type="submit">Enviar consulta</button>
  </form>
<% } %>

<%- include('partials/footer') %>
