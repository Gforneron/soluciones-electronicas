<%- include('../partials/head') %>
<%- include('../partials/header') %>

<p><a href="/soluciones">Volver a soluciones</a></p>
<h1><%= solucion.titulo %></h1>
<p class="categoria"><%= solucion.categoria %></p>
<p class="lead"><%= solucion.descripcion %></p>

<h2>Qué incluye</h2>
<ul class="lista">
  <% solucion.incluye.forEach(function (item) { %>
    <li><%= item %></li>
  <% }) %>
</ul>

<a class="boton" href="/contacto">Consultar por este servicio</a>

